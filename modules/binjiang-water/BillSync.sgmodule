#!name=滨江水费同步
#!desc=微信打开已配置水户的清单后同步账单，并在 Surge 面板显示最近一期水量、金额及 HA 核对结果。
#!version=2.0
#!arguments=ACCOUNT:unset,RECEIVER_URL:unset,PAIR_KEY:unset
#!arguments-desc=ACCOUNT：水务户号。\nRECEIVER_URL：NAS 接收服务地址，含协议和端口。\nPAIR_KEY：接收服务配对密钥。

[Script]
滨江水费清单 = type=http-response, pattern=^http://wx\.htwa\.com\.cn/WeChatNews/plugins/wechat\.action\?method=queryBill&huhao=[0-9]+$, requires-body=true, max-size=524288, timeout=15, script-path=https://raw.githubusercontent.com/unicom2zero/AI_rule_for_surge/main/modules/binjiang-water/bill.js, argument="{{{ACCOUNT}}}|{{{RECEIVER_URL}}}|{{{PAIR_KEY}}}"
滨江水费状态 = type=generic, script-path=https://raw.githubusercontent.com/unicom2zero/AI_rule_for_surge/main/modules/binjiang-water/bill.js, argument="{{{ACCOUNT}}}|{{{RECEIVER_URL}}}|{{{PAIR_KEY}}}"

[Panel]
滨江水费 = title="滨江水费", content="等待打开水费清单", style=info, script-name=滨江水费状态, update-interval=1
